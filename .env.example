# --- required ---
API_KEY=change-me-to-a-long-random-string-of-at-least-8-characters

# --- recommended ---
ALLOWED_USERS=eamonn,wife        # Authelia Remote-User allowlist; empty = anyone past the proxy
# Allowlist of tracked homeowner person ids (as sent in homeowner_home/away signals).
# Only these count toward presence; anyone else (e.g. a 'test' person from a smoke
# test) is ignored, so stray signals can't poison the home/away count. Empty = any.
HOMEOWNER_PERSONS=eamonn_upperton,puiyi_liew

# --- optional (defaults shown) ---
# TZ=Australia/Melbourne
# SCREENSHOT_RETENTION_DAYS=90
# FY_START_MONTH=7               # AU=7, NZ=4, calendar year=1
# HA_DEBOUNCE_MINUTES=15

# --- dev only ---
# DEV_MODE=true                  # bypasses auth & api key — DO NOT set in prod
# DEV_USER=eamonn
